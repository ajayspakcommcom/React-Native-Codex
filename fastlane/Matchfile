git_url(ENV["MATCH_GIT_URL"] || "git@github.com:your-org/mobile-signing.git")
storage_mode("git")
type(ENV["MATCH_TYPE"] || "appstore")
readonly(ENV["CI"] == "true")

app_identifier([
  ENV.fetch("IOS_BUNDLE_IDENTIFIER", "org.reactjs.native.example.ReactNativeCodex")
])

username(ENV["APP_STORE_CONNECT_APPLE_ID"])
team_id(ENV["APPLE_DEVELOPER_TEAM_ID"]) if ENV["APPLE_DEVELOPER_TEAM_ID"]
